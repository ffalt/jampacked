    "@react-navigation/bottom-tabs": "7.18.18",
    "@react-navigation/core": "7.21.13",
    "@react-navigation/material-top-tabs": "7.6.17",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@react-navigation/stack": "7.10.24",
    "axios": "1.20.0",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "graphql": "17.0.2",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-bootsplash": "7.3.2",
    "react-native-gesture-handler": "3.2.1",
