    "globals": "17.12.0",
    "graphql-tag": "2.12.7",
    "jest": "30.5.1",
    "lodash.chunk": "4.2.0",
    "lodash.throttle": "4.1.1",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "test-renderer": "1.2.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "reactNativeVectorIcons": {
    "fontDir": "src/assets/fonts"
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
